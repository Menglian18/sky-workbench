<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 不允许任何形式的自动备份与多设备转移：数据只在手机本地（见 PRD §7.1） -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
